# ------------------------------------------------------------------
# Jotion environment variables
#
# Copy this file to `.env.local` and fill in the values.
# ------------------------------------------------------------------

# Convex (https://dashboard.convex.dev) — `npx convex dev` will print these
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk (https://dashboard.clerk.com) — used for authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Edge Store (https://edgestore.dev) — optional.
# When these are not set, Jotion falls back to a local filesystem storage
# (see `app/api/upload`).
EDGE_STORE_ACCESS_KEY=
EDGE_STORE_SECRET_KEY=

# --------------------------------------------------------------------------
# Payments — Razorpay (optional)
# --------------------------------------------------------------------------
# Without these the checkout falls back to the demo card form.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# The webhook secret (Razorpay dashboard → Settings → Webhooks)
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
# The rate that is used to convert the USD price into INR
# RAZORPAY_INR_PER_USD=83
# The publishable key for the browser widget
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# --------------------------------------------------------------------------
# AI assistant (optional)
# --------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# OPENAI_API_KEY=sk-xxxxxxxx

# --------------------------------------------------------------------------
# Development sign-in (optional, never enable this in production)
# --------------------------------------------------------------------------
# ALLOW_DEV_AUTH=true
# DEV_AUTH_SECRET=<the JWT secret of the Convex deployment>
