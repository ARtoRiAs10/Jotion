# Environment variables for production builds.
#
# Next.js loads this file automatically when NODE_ENV=production, so a
# `npm run build` (and therefore every Vercel build) talks to the production
# Convex deployment. Real environment variables in the hosting platform
# always take precedence over the values in this file.

# The production Convex deployment (https://impartial-nightingale-31.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=https://impartial-nightingale-31.convex.cloud

# The Clerk publishable key has to be set in the hosting platform
# (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY) — the test key is only for local
# development.
